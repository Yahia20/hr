# ---------------------------------------------------------------------------
# HR System — environment variables. Copy to .env for local dev, or set these
# in your host's dashboard (Railway → Variables) for production.
# .env is git-ignored and never baked into the Docker image.
# ---------------------------------------------------------------------------

# --- REQUIRED in production ---

# Serve secure (HTTPS-only) cookies. MUST be "true" in production.
COOKIE_SECURE=true

# Public https URL of the deployed app. Drives the password-reset links.
APP_BASE_URL=https://your-app.up.railway.app

# Database. Leave DATABASE_URL unset to use SQLite at HR_DB_FILE (the default;
# on Railway mount a Volume and point HR_DB_FILE at it, else the file is wiped on
# every redeploy). Set DATABASE_URL to a PostgreSQL connection string to use
# Postgres instead — HR_DB_FILE is then ignored. Railway's postgres:// scheme is
# accepted and normalized. A managed Postgres brings automatic backups.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
HR_DB_FILE=/data/hr_system.db

# One-shot SQLite→PostgreSQL migration at startup, for a config-only cutover with
# no terminal access. Set MIGRATE_ON_BOOT=1 together with a fresh (empty)
# DATABASE_URL while HR_DB_FILE still points at the existing SQLite volume: on the
# next boot the app copies every row into Postgres, verifies it, then serves from
# Postgres. It is idempotent (skips once the target has data) and aborts startup
# loudly if verification fails, so it's safe to leave on — but remove it after the
# first successful boot. Leave unset for normal operation.
# MIGRATE_ON_BOOT=1

# First HR Manager account, seeded only when the users table is empty.
HR_BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
HR_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password
HR_BOOTSTRAP_ADMIN_NAME=HR Manager

# --- Optional ---

# Comma-separated allowed origins for cross-origin browser calls. Not needed
# when the SPA is served from the same origin (the default Docker setup).
# CORS_ORIGINS=https://your-app.up.railway.app

# Email delivery (password-reset + violation notifications). Use Resend OR SMTP.
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hr@yourcompany.com

# PERMISSION_MONTHLY_QUOTA=2             # early-leave permissions per employee per month

# Document-expiry email reminders (a daily digest of expiring/expired documents).
# Recipients are normally set in-app (Settings → Document expiry reminders), which
# needs no redeploy. DOC_ALERT_EMAIL only seeds them when none are set in-app.
# DOC_ALERT_EMAIL=alerts@yourcompany.com   # comma-separated fallback recipients
# DOC_REMINDER_HOUR=8                       # hour of day (0-23, server time) to send
